VITE_CONTRACT_ADDRESS=0xb3d76B5517a14A846e9FF8b73a48e582A034de25

# Leave VITE_STUDIO_RPC unset in deployment. The app then reads through its own
# same-origin path /api/rpc, which vercel.json rewrites to Studio. Setting it to
# an absolute URL restores the cross-origin call and with it the opaque
# "Failed to fetch" that hides Studio's rate-limit responses.
# VITE_STUDIO_RPC=/api/rpc

# Only used when MetaMask is asked to add the network, which needs an absolute
# URL it can reach on its own.
VITE_STUDIO_WALLET_RPC=https://studio.genlayer.com/api

VITE_EXPLORER_BASE=https://explorer-studio.genlayer.com
